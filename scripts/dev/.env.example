# scripts/dev/pi_ssh.py + scripts/dev/hantal_ssh.py connection config.
# Copy this file to scripts/dev/.env and fill in real values.
# scripts/dev/.env is GITIGNORED (root .gitignore `.env` rule) — never commit it.
PI_HOST=192.168.x.x
PI_USER=root
PI_PASSWORD=change-me
# Optional: default working dir; commands run from here unless they start with `cd `
# or you pass --no-cd.
PI_DIR=/root/minder
# Only needed when this dev host has no direct tailnet route (see HANTAL_SOCKS5
# below for the full explanation). Leave blank if this host is a normal tailnet
# peer already.
PI_SOCKS5=localhost:1055

# scripts/dev/hantal_ssh.py — Windows dev box (runs its own full local Docker stack).
# Auth is SSH key-based (OpenSSH Server on Windows), not password.
HANTAL_HOST=100.x.x.x
HANTAL_USER=you@example.com
HANTAL_KEY=~/.ssh/hantal_windows
HANTAL_DIR=E:\Projects\personal\minder
# Only needed when this dev host has no direct tailnet route (e.g. a sandboxed
# container with no /dev/net/tun, so tailscaled runs in
# --tun=userspace-networking mode). Leave blank if this host is a normal
# tailnet peer already (real tailscale0 interface).
HANTAL_SOCKS5=localhost:1055

# scripts/dev/remote_ssh.py dev2 — Linux dev box on the tailnet (password SSH;
# it doesn't run the Tailscale SSH server, so reach it by tailnet IP). Checkout
# lives at /opt/workspace/minder.
DEV2_HOST=100.x.x.x
DEV2_USER=root
DEV2_PASSWORD=change-me
DEV2_DIR=/opt/workspace/minder
